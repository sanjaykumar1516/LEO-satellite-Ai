# VITE_WS_URL=ws://localhost:8000/ws
# Optional published Spline scene embed URL (visual only unless events are integrated)
# VITE_SPLINE_SCENE_URL=https://my.spline.design/your-scene/
# When running frontend with npm outside Docker:
# VITE_DEV_BACKEND_URL=http://localhost:8000
